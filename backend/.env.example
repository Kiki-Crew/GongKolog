# ── LLM 키 (백엔드 전용, 절대 프론트 노출 금지) ──
GEMINI_API_KEY=your-gemini-key
GROQ_API_KEY=your-groq-key

# 모델명 (스펙 4.3 — docs 확인 후 조정)
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=qwen-2.5-32b

# ── Supabase ──
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # service_role 키 (백엔드 전용)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret      # JWT 검증용 (Project Settings > API)

# ── 임베딩 ──
EMBED_MODEL=BAAI/bge-m3
EMBED_DEVICE=cpu

# ── Mock 모드 (키/모델 없이 파이프라인 검증용) ──
# 실서비스에선 false. 둘 다 true면 키·BGE-M3 없이 analyze() 동작.
MOCK_LLM=false
MOCK_EMBEDDING=false

# ── CORS (프론트 주소) ──
FRONTEND_ORIGIN=http://localhost:5173
